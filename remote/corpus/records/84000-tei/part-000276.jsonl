{"id":349786,"corpus":"84000-tei","language":"en","collection_name":"kangyur","work_id":"UT22084-089-013","segment_id":"UT22084-089-013-2297","title":"The Sūtra of the Sublime Golden Light (2)","raw_text":"“ ‘The king collected those two sons;","source_path":"84000/data-tei/translations/kangyur/translations/089-013_toh556-the_sutra_of_the_sublime_golden_light_2.xml","source_sha":"bdfc81c9aecdfaf93e084ab64a885577de773046","evidence_class":"authoritative_structured","text_role":"translation_main","witness":"toh556","sequence_no":3482,"relation_ids":["toh556"],"export_role":"context_overlap"}
